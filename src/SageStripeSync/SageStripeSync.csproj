<?xml version="1.0" encoding="utf-8"?>
<!--
  Classic (non-SDK-style) csproj, buildable with the legacy MSBuild that ships
  in the .NET Framework runtime folder (no Visual Studio / dotnet SDK needed):

    C:\Windows\Microsoft.NET\Framework64\v4.0.30319\MSBuild.exe SageStripeSync.csproj /p:Configuration=Release

  Notes:
  - PlatformTarget is x86 because Sage.Peachtree.API.dll is a 32-bit-only assembly.
  - TargetFrameworkVersion is v4.0 because this machine has no .NET targeting
    packs (reference assemblies); MSBuild falls back to compiling against the
    installed 4.8 runtime assemblies for v4.0. The app runs on .NET 4.8.
  - SageSdkPath is overridable: /p:SageSdkPath=C:\path\to\sage\dlls
-->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{7A3F2C41-8B0D-4E7A-9C55-1D2E3F405060}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SageStripeSync</RootNamespace>
    <AssemblyName>SageStripeSync</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <PlatformTarget>x86</PlatformTarget>
    <FileAlignment>512</FileAlignment>
    <SageSdkPath Condition=" '$(SageSdkPath)' == '' ">$(MSBuildProjectDirectory)\..\..\lib\sage</SageSdkPath>
    <PackagesPath>$(MSBuildProjectDirectory)\..\..\packages</PackagesPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Sage.Peachtree.API">
      <HintPath>$(SageSdkPath)\Sage.Peachtree.API.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Stripe.net">
      <HintPath>$(PackagesPath)\stripe.net.45.14.0\lib\net461\Stripe.net.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PackagesPath)\newtonsoft.json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>$(PackagesPath)\microsoft.bcl.asyncinterfaces.1.1.0\lib\net461\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>$(PackagesPath)\system.threading.tasks.extensions.4.5.4\lib\net461\System.Threading.Tasks.Extensions.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(PackagesPath)\system.runtime.compilerservices.unsafe.4.5.3\lib\net461\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.Runtime.InteropServices.RuntimeInformation">
      <HintPath>$(PackagesPath)\system.runtime.interopservices.runtimeinformation.4.3.0\lib\net45\System.Runtime.InteropServices.RuntimeInformation.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="AppConfig.cs" />
    <Compile Include="SecretStore.cs" />
    <Compile Include="Logger.cs" />
    <Compile Include="Models.cs" />
    <Compile Include="SageGateway.cs" />
    <Compile Include="StripeGateway.cs" />
    <Compile Include="SyncEngine.cs" />
    <Compile Include="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="SettingsForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <!-- The Sage 50 .NET SDK assembly needs its sibling assemblies at runtime;
         copy the whole set next to the exe. -->
    <SageRuntimeDll Include="$(SageSdkPath)\*.dll" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopySageRuntimeDlls" AfterTargets="Build">
    <Copy SourceFiles="@(SageRuntimeDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
